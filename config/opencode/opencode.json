{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "autoupdate": true,
  "permission": {
    "lsp": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "grep": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "question": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "local.properties": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "gh *": "allow",
      "gh pr create *": "deny",
      "./gradlew *": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit *": "deny",
          "git push *": "deny",
          "grep *": "allow",
          "gh *": "allow",
          "gh pr create *": "deny",
          "./gradlew *": "allow"
        }
      }
    }
  }
}
