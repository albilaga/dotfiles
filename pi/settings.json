{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "theme": "catppuccin-latte/catppuccin-frappe",
  "collapseChangelog": true,
  "hideThinkingBlock": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-sol:medium",
    "openai-codex/gpt-6-astra:low",
    "openrouter/z-ai/glm-5.3-flash:high",
    "openrouter/deepseek/deepseek-v4-flash-0731:high"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": { "model": "openrouter/deepseek/deepseek-v4-flash-0731" },
      "delegate": { "model": "openrouter/z-ai/glm-5.3-flash" },
      "researcher": { "model": "openrouter/z-ai/glm-5.3-flash" },
      "worker": { "model": "openai-codex/gpt-5.6-sol" },
      "reviewer": { "model": "openai-codex/gpt-5.6-sol" },
      "oracle": { "model": "openai-codex/gpt-5.6-sol" }
    }
  },
  "terminal": {
    "showImages": true
  },
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@pi-archimedes/image-paste",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-caveman",
    "npm:pi-web-access",
    "npm:pi-catppuccin"
  ]
}
