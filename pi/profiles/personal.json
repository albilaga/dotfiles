{
  "enabledModels": [
    "openai-codex/gpt-5.6-sol:medium",
    "zai/glm-5.3-flash:high"
  ],
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["zai/*", "openai-codex/gpt-5*"]
    },
    "agentOverrides": {
      "scout": { "model": "zai/glm-5.3-flash" },
      "delegate": { "model": "zai/glm-5.3-flash" },
      "researcher": { "model": "zai/glm-5.3-flash" },
      "worker": { "model": "zai/glm-5.3-flash" },
      "reviewer": { "model": "zai/glm-5.3-flash" },
      "oracle": { "model": "openai-codex/gpt-5.6-sol" }
    }
  }
}
